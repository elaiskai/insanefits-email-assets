        {
         "id": "6a212b4aa8b580d24e1ebfa3",
         "type": "htmlCode",
         "htmlCode": {
          "style": "p { text-align: center; }",
          "body": "\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n<tr><td align=\"center\" style=\"padding:0;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:600px;margin:0 auto;background-color:#ffffff;font-family:&#39;Barlow&#39;,Arial,Helvetica,sans-serif;\">\n  <tr><td align=\"left\" style=\"padding:24px 36px 44px 24px;text-align:left;\">\n    <p style=\"margin:0 0 8px 0;color:#bfa61f;font-size:13px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;text-align:left;\"></p>\n    <h1 style=\"margin:0;color:#1a1a1a;font-size:30px;line-height:1.12;font-weight:800;letter-spacing:-0.02em;text-align:left;\">Tavo nuomonė svarbi</h1>\n    <p style=\"margin:16px 0 0 0;color:#4a4a4a;font-size:16px;line-height:1.65;font-weight:500;text-align:left;\">\n      Nuoširdžiai dėkoju, kad pasirinkai Insane Fits ir pasitikėjai mano komanda. Viliuosi, kad produktai tau patiko ir jau spėjai pajusti jų naudą.\n    </p>\n    <p style=\"margin:16px 0 0 0;color:#4a4a4a;font-size:16px;line-height:1.65;font-weight:500;text-align:left;\">\n      Jei gali, palik trumpą atsiliepimą - tai padeda kitiems lengviau apsispręsti ir man toliau tobulinti Insane Fits.\n    </p>\n    <p style=\"margin:24px 0 0 0;color:#1a1a1a;font-size:16px;font-weight:700;text-align:left;\">Pirmyn!</p>\n    <p style=\"margin:4px 0 0 0;color:#4a4a4a;font-size:15px;font-weight:600;text-align:left;\">Lukas</p>\n  </td></tr>\n</table>\n</td></tr>\n</table>"
         }
        }
       ]
      }
     ]
    }
   ],
