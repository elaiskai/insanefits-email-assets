        {
         "id": "6a21280108d6406b756514dc",
         "type": "htmlCode",
         "htmlCode": {
          "style": "p { text-align: center; }",
          "body": "\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n<tr><td align=\"center\" style=\"padding:0;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:600px;margin:0 auto;background-color:#ffffff;font-family:&#39;Barlow&#39;,Arial,Helvetica,sans-serif;\">\n\n  <tr><td style=\"padding:24px 36px 0 36px;\">\n    <p style=\"margin:0 0 8px 0;color:#bfa61f;font-size:13px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;\">Kas naujo</p>\n<h1 style=\"margin:0;color:#1a1a1a;font-size:32px;line-height:1.12;font-weight:800;letter-spacing:-0.02em;text-align:center;\">Insane Fits juda į priekį</h1>    <p style=\"margin:16px 0 0 0;color:#4a4a4a;font-size:16px;line-height:1.65;font-weight:500;\">\n      Per tą laiką, kol nebuvai užsukęs, toliau stiprinome asortimentą, dėmesį kokybei ir patirtį, kad rasti tinkamus papildus būtų dar paprasčiau. Prie Insane Fits jau prisijungė daugiau nei 8000 žmonių bendruomenė, o tau sugrįžimui paruošta 15% nuolaida.\n    </p>\n  </td></tr>\n\n  \n  <tr><td style=\"padding:26px 36px 0 36px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f2f2f2;border-radius:14px;\">\n      <tr>\n        <td align=\"center\" width=\"50%\" style=\"padding:22px 12px;border-right:1px solid #333;\">\n          <p style=\"margin:0;color:#F77F00;font-size:28px;line-height:1;font-weight:900;\">15,000+</p>\n          <p style=\"margin:7px 0 0 0;color:#ff;font-size:13px;font-weight:600;\">žmonių bendruomenėje</p>\n        </td>\n        <td align=\"center\" width=\"50%\" style=\"padding:22px 12px;\">\n          <p style=\"margin:0;color:#F77F00;font-size:28px;line-height:1;font-weight:900;\">100%</p>\n          <p style=\"margin:7px 0 0 0;color:#ff;font-size:13px;font-weight:600;\">laboratoriškai tikrinama</p>\n        </td>\n      </tr>\n    </table>\n  </td></tr>\n\n  \n  <tr><td style=\"padding:24px 36px 0 36px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#fbf8ec;border:2px dashed #fbcd0a;border-radius:14px;\">\n      <tr><td align=\"center\" style=\"padding:22px;\">\n        <p style=\"margin:0;color:#1a1a1a;font-size:38px;line-height:1;font-weight:900;\">-15% nuolaida</p>\n        <p style=\"margin:8px 0 0 0;color:#8a7a3a;font-size:13px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;\">Tavo asmeninis kodas žemiau</p>\n      </td></tr>\n    </table>\n    \n  </td></tr>\n\n  \n\n</table>\n</td></tr>\n</table>\n"
