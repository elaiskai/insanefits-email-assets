        {
         "id": "6a2135de7ca34ee049eca17d",
         "type": "htmlCode",
         "htmlCode": {
          "style": "p { text-align: center; }",
          "body": "\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;\">\n<tr><td align=\"center\" style=\"padding:0;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:600px;margin:0 auto;background-color:#ffffff;font-family:&#39;Barlow&#39;,Arial,Helvetica,sans-serif;\">\n  <tr><td align=\"center\" style=\"padding:24px 36px 0 36px;text-align:center;\">\n    <p style=\"margin:0 0 8px 0;color:#bfa61f;font-size:13px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;text-align:center;\"></p>\n    <h1 style=\"margin:0;color:#1a1a1a;font-size:32px;line-height:1.12;font-weight:800;letter-spacing:-0.02em;text-align:center;\">Tavo krepšelis vis dar čia</h1>\n    <p style=\"margin:16px 0 0 0;color:#4a4a4a;font-size:16px;line-height:1.65;font-weight:500;text-align:center;\">\n      Švelniai primenu, kad tavo krepšelyje palikti produktai dar laukia, bet jų kiekis gali pasibaigti. Jei kažkas neaišku dėl pasirinkimo ar vartojimo, gali parašyti man ir padėsiu.\n    </p>\n  </td></tr>\n  \n  <tr><td align=\"center\" style=\"padding:28px 36px 0 36px;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n      <tr><td align=\"center\" bgcolor=\"#F77F00\" style=\"border-radius:8px;\">\n        <a href=\"[[event.raw.abandoned_checkout_url]]\" target=\"_blank\" style=\"display:inline-block;padding:18px 48px;font-size:17px;font-weight:800;color:#ffffff;text-decoration:none;text-transform:uppercase;letter-spacing:0.04em;border-radius:8px;\">Grįžti į krepšelį</a>\n      </td></tr>\n    </table>\n  </td></tr>\n  <tr><td align=\"center\" style=\"padding:34px 36px 44px 36px;text-align:center;\">\n    <p style=\"margin:0;color:#1a1a1a;font-size:16px;font-weight:700;text-align:center;\">Pirmyn!</p>\n    <p style=\"margin:4px 0 0 0;color:#4a4a4a;font-size:15px;font-weight:600;text-align:center;\">Lukas</p>\n  </td></tr>\n</table>\n</td></tr>\n</table>"
         }
        }
       ]
      }
     ]
    }
   ],
