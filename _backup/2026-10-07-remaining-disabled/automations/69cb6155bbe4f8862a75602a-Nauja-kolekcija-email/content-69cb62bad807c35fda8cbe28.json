         "id": "69cb63c11b45852a355d139c",
         "type": "text",
         "text": "<p style=\"margin-top: 0px; margin-bottom: 0px; text-align: left;\"><span style=\"font-size: 20px; font-family: Georgia, serif;\"><strong><span style=\"color: #FFFFFF;\">Sveikinu prisijungus!</span></strong></span></p><p style=\"margin-top: 0px; margin-bottom: 0px;\"><a></a><a></a></p><p style=\"margin-top: 0px; margin-bottom: 0px;\"><a></a><a></a></p><p style=\"margin-top: 0px; margin-bottom: 0px;\"><a></a><a></a></p><p style=\"margin-top: 0px; margin-bottom: 0px;\"><a></a><a></a></p><p style=\"margin-top: 0px; margin-bottom: 0px;\"><a></a><a></a></p><p style=\"margin-top: 0px; margin-bottom: 0px;\"><a></a><a></a></p>",
